<?php 
 /**
 * Carousel component — Juksgraphic / Penguin UI
 *
 * Reusable carousel powered by Swiper.js (npm) and Alpine.js.
 * Works with Laravel Blade and BladeOne.
 *
 * @param string      $variant       'slides-only'|'controls'|'indicators'|'captions'|'crossfade'|'individual-interval'|'no-touch'|'dark'|'coverflow'|'cards'|'creative'. Default: 'slides-only'.
 * @param array       $slides        Array of slides: [['img' => 'url', 'alt' => '', 'caption_title' => '', 'caption_text' => '', 'interval' => 3000]]. Default: [].
 * @param bool        $autoplay      Enable autoplay. Default: false.
 * @param int         $autoplayDelay Autoplay delay in milliseconds. Default: 3000.
 * @param bool        $loop          Infinite loop. Default: true.
 * @param string      $height        Tailwind height class (e.g., 'h-72', 'h-96'). Default: 'h-72'.
 * @param string|null $id            Custom ID. Default: generated hex.
 * @param string      $wrapClass     Additional wrapper classes. Default: ''.
 * @param bool        $dark          Force dark theme for controls. Default: false.
 * @param string|null $effect        Force Swiper effect ('slide'|'fade'|'coverflow'|'cards'|'creative'). Default: null.
 */

 /** @var string $variant */
 $variant = (string) ($variant ?? 'slides-only');

 /** @var array $slides */
 $slides = $slides ?? [];

 /** @var bool $autoplay */
 $autoplay = (bool) ($autoplay ?? false);

 /** @var int $autoplayDelay */
 $autoplayDelay = (int) ($autoplayDelay ?? 3000);

 /** @var bool $loop */
 $loop = (bool) ($loop ?? true);

 /** @var string $height */
 $height = (string) ($height ?? 'h-72');

 /** @var string $wrapClass */
 $wrapClass = (string) ($wrapClass ?? '');

 /** @var bool $dark */
 $dark = (bool) ($dark ?? false);

 /** @var string $carouselId */
 $carouselId = $id ?? 'swiper-' . bin2hex(random_bytes(4));

 /** @var string|null $effect */
 $effect = $effect ?? null;

 /** @var array<string, string> $_effectMap */
 $_effectMap = [
 'slides-only' => 'slide',
 'controls' => 'slide',
 'indicators' => 'slide',
 'captions' => 'slide',
 'crossfade' => 'fade',
 'individual-interval' => 'slide',
 'no-touch' => 'slide',
 'dark' => 'slide',
 'coverflow' => 'coverflow',
 'cards' => 'cards',
 'creative' => 'creative',
 ];
 $_swiperEffect = $effect ?? ($_effectMap[$variant] ?? 'slide');

 /** @var bool $_showControls */
 $_showControls = in_array(
 $variant,
 ['controls', 'captions', 'individual-interval', 'dark', 'no-touch', 'creative'],
 true,
 );

 /** @var bool $_showDots */
 $_showDots = in_array($variant, ['indicators', 'captions', 'dark', 'cards', 'coverflow', 'creative'], true);

 /** @var bool $_noTouch */
 $_noTouch = $variant === 'no-touch';

 /** @var bool $_isDark */
 $_isDark = $dark || $variant === 'dark';

 /** @var string $_btnBase */
 $_btnBase =
 'absolute top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-9 h-9 rounded-full transition-all duration-200 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current ';

 /** @var string $_btnTheme */
 $_btnTheme = $_isDark
 ? 'bg-black/50 text-white hover:bg-black/70 border border-white/20'
 : 'bg-white/80 dark:bg-black/50 text-on-surface dark:text-white hover:bg-white dark:hover:bg-black/70 shadow-md border border-outline/20 dark:border-white/20';

 /** @var string $_wrapperBase */
 $_wrapperBase = 'relative w-full overflow-hidden rounded-radius';
 if (in_array($_swiperEffect, ['coverflow', 'cards'], true)) {
 $_wrapperBase .= ' overflow-visible';
 }
 ?>

<?php /* ═══════════════════════════ Template ═══════════════════════════ */ ?>
<div x-data="{
 swiper: null,
 activeIndex: 0,
 totalSlides: <?php echo \htmlentities(count($slides)??'', ENT_QUOTES, 'UTF-8', false); ?>,
 init() {
 this.swiper = new Swiper(this.$refs.swiperEl, {
 effect: '<?php echo \htmlentities($_swiperEffect??'', ENT_QUOTES, 'UTF-8', false); ?>',
 loop: <?php echo \htmlentities($loop ? 'true' : 'false'??'', ENT_QUOTES, 'UTF-8', false); ?>,
 allowTouchMove: <?php echo \htmlentities($_noTouch ? 'false' : 'true'??'', ENT_QUOTES, 'UTF-8', false); ?>,
 grabCursor: <?php echo \htmlentities(!$_noTouch ? 'true' : 'false'??'', ENT_QUOTES, 'UTF-8', false); ?>,
 speed: <?php echo \htmlentities($_swiperEffect === 'fade' ? 600 : 400??'', ENT_QUOTES, 'UTF-8', false); ?>,
 observer: true,
 observeParents: true,
 <?php if($autoplay || $variant === 'individual-interval'): ?> autoplay: {
 delay: <?php echo \htmlentities($autoplayDelay??'', ENT_QUOTES, 'UTF-8', false); ?>,
 disableOnInteraction: false,
 pauseOnMouseEnter: true,
 }, <?php endif; ?>
 <?php if($_swiperEffect === 'coverflow'): ?> centeredSlides: true,
 slidesPerView: 'auto',
 coverflowEffect: {
 rotate: 40,
 stretch: 0,
 depth: 120,
 modifier: 1,
 slideShadows: true,
 },
 <?php elseif($_swiperEffect === 'cards'): ?>
 centeredSlides: true,
 slidesPerView: 'auto',
 cardsEffect: {
 slideShadows: true,
 perSlideOffset: 8,
 perSlideRotate: 2,
 },
 <?php elseif($_swiperEffect === 'creative'): ?>
 centeredSlides: true,
 slidesPerView: 1,
 creativeEffect: {
 prev: { shadow: true, translate: ['-120%', 0, -500] },
 next: { translate: ['120%', 0, 0] },
 },
 <?php elseif($_swiperEffect === 'fade'): ?>
 fadeEffect: { crossFade: true }, <?php endif; ?>
 on: {
 slideChange: (sw) => {
 this.activeIndex = sw.realIndex;
 },
 },
 });
 },
 goTo(idx) { this.swiper && this.swiper.slideToLoop(idx); },
 prev() { this.swiper && this.swiper.slidePrev(); },
 next() { this.swiper && this.swiper.slideNext(); },
}" x-init="init()" class="<?php echo \htmlentities($_wrapperBase??'', ENT_QUOTES, 'UTF-8', false); ?> <?php echo \htmlentities($wrapClass??'', ENT_QUOTES, 'UTF-8', false); ?>">

 <?php /* Swiper Container (avec hauteur explicite pour éviter l'affichage à 0px) */ ?>
 <div x-ref="swiperEl" class="swiper <?php echo \htmlentities($height??'', ENT_QUOTES, 'UTF-8', false); ?> w-full <?php echo \htmlentities($_isDark ? 'carousel-dark' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="swiper-wrapper h-full">
 <?php if(empty($slides)): ?>
 echo "Slides vides";
 <?php endif; ?>
 <?php $__currentLoopData = $slides; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $_si => $_slide): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $_slideAttrs = '';
 if ($variant === 'individual-interval' && !empty($_slide['interval'])) {
 $_slideAttrs = 'data-swiper-autoplay="' . (int) $_slide['interval'] . '"';
 }
 ?>
 <div class="swiper-slide h-full <?php echo \htmlentities(in_array($_swiperEffect, ['coverflow', 'cards'], true) ? 'w-72 md:w-80' : 'w-full'??'', ENT_QUOTES, 'UTF-8', false); ?>"
 <?php echo $_slideAttrs; ?>>

 <?php /* Slide Content */ ?>
 <div
 class="relative h-full w-full overflow-hidden <?php echo \htmlentities($_swiperEffect === 'cards' ? 'rounded-xl' : 'rounded-radius'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if(!empty($_slide['img'])): ?>
 <img src="<?php echo \htmlentities($_slide['img']??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($_slide['alt'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="w-full h-full object-cover block">
 <?php else: ?>
 <?php 
 $_placeholderColors = [
 'bg-primary/20',
 'bg-secondary/20',
 'bg-success/20',
 'bg-warning/20',
 'bg-info/20',
 ];
 $_bg = $_placeholderColors[$_si % count($_placeholderColors)];
 ?>
 <div class="w-full h-full <?php echo \htmlentities($_bg??'', ENT_QUOTES, 'UTF-8', false); ?> flex items-center justify-center">
 <svg class="w-12 h-12 text-on-surface/20 dark:text-on-surface-dark/20" fill="none"
 stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
 d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
 </svg>
 </div>
 <?php endif; ?>

 <?php /* Caption Overlay */ ?>
 <?php if(!empty($_slide['caption_title']) || !empty($_slide['caption_text'])): ?>
 <div
 class="absolute inset-x-0 bottom-0 px-5 py-4 <?php echo \htmlentities($_isDark ? 'bg-gradient-to-t from-black/80 via-black/50 to-transparent text-white' : 'bg-gradient-to-t from-black/70 via-black/40 to-transparent text-white'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if(!empty($_slide['caption_title'])): ?>
 <h6 class="text-base font-semibold font-title mb-0.5">
 <?php echo \htmlentities($_slide['caption_title']??'', ENT_QUOTES, 'UTF-8', false); ?></h6>
 <?php endif; ?>
 <?php if(!empty($_slide['caption_text'])): ?>
 <p class="text-sm text-white/80 leading-snug"><?php echo \htmlentities($_slide['caption_text']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <?php endif; ?>
 </div>
 <?php endif; ?>
 </div>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 </div>

 <?php /* Controls Prev / Next */ ?>
 <?php if($_showControls): ?>
 <button type="button" @click="prev()" class="<?php echo \htmlentities($_btnBase??'', ENT_QUOTES, 'UTF-8', false); ?> left-3 <?php echo \htmlentities($_btnTheme??'', ENT_QUOTES, 'UTF-8', false); ?>"
 aria-label="Previous slide">
 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
 </svg>
 </button>
 <button type="button" @click="next()" class="<?php echo \htmlentities($_btnBase??'', ENT_QUOTES, 'UTF-8', false); ?> right-3 <?php echo \htmlentities($_btnTheme??'', ENT_QUOTES, 'UTF-8', false); ?>"
 aria-label="Next slide">
 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
 </svg>
 </button>
 <?php endif; ?>

 <?php /* Indicators / Dots */ ?>
 <?php if($_showDots): ?>
 <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10 flex items-center gap-1.5">
 <?php $__currentLoopData = $slides; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $_di => $_ignored): $loop = $this->incrementLoopIndices();  ?>
 <button type="button" @click="goTo(<?php echo \htmlentities($_di??'', ENT_QUOTES, 'UTF-8', false); ?>)"
 :class="activeIndex === <?php echo \htmlentities($_di??'', ENT_QUOTES, 'UTF-8', false); ?> ?
 'w-5 h-2 <?php echo \htmlentities($_isDark ? 'bg-white' : 'bg-primary'??'', ENT_QUOTES, 'UTF-8', false); ?> rounded-full' :
 'w-2 h-2 <?php echo \htmlentities($_isDark ? 'bg-white/50 hover:bg-white/80' : 'bg-white/70 hover:bg-white'??'', ENT_QUOTES, 'UTF-8', false); ?> rounded-full'"
 class="transition-all duration-300 rounded-full focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
 aria-label="Go to slide <?php echo \htmlentities($_di + 1??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </button>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 <?php endif; ?>
</div>
