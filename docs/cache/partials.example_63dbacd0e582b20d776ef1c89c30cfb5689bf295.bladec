
<?php 
 
 $source = trim($slot, "\r\n");
 preg_match_all('/^[ \t]*(?=\S)/m', $source, $m);
 $indent = $m[0] ? min(array_map('strlen', $m[0])) : 0;

 if ($indent > 0) {
 $source = preg_replace('/^[ \t]{0,' . $indent . '}/m', '', $source);
 }
 
 $source = trim($source);
 if (!empty($replace)) {
 $source = strtr($source, $replace);
 }
 ?>
<div x-data="{ tab: 'preview' }"
 class="mt-5 overflow-hidden rounded-radius border border-outline dark:border-outline-dark">

 <?php /* Onglets */ ?>
 <div class="border-b border-outline bg-surface px-3 py-2 dark:border-outline-dark dark:bg-surface-dark">
 <div class="inline-flex gap-1 rounded-radius bg-surface-alt p-1 text-xs font-medium dark:bg-surface-dark-alt"
 role="tablist">
 <button type="button" role="tab" @click="tab = 'preview'" :aria-selected="tab === 'preview'"
 class="rounded-radius px-3 py-1 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-dark"
 :class="tab === 'preview'
 ? 'bg-primary text-on-primary dark:bg-primary-dark dark:text-on-primary-dark'
 : 'text-on-surface/70 hover:text-on-surface-strong dark:text-on-surface-dark/70 dark:hover:text-on-surface-dark-strong'">
 Preview
 </button>
 <button type="button" role="tab" @click="tab = 'code'" :aria-selected="tab === 'code'"
 class="rounded-radius px-3 py-1 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-dark"
 :class="tab === 'code'
 ? 'bg-primary text-on-primary dark:bg-primary-dark dark:text-on-primary-dark'
 : 'text-on-surface/70 hover:text-on-surface-strong dark:text-on-surface-dark/70 dark:hover:text-on-surface-dark-strong'">
 Code
 </button>
 </div>
 </div>

 <?php /* Aperçu */ ?>
 <div x-show="tab === 'preview'" class="bg-surface-alt p-6 dark:bg-surface-dark-alt">
 <?php echo $this->runString($source); ?>

 </div>

 <?php /* Code (comment appeler le composant) */ ?>
 <div x-show="tab === 'code'" x-cloak>
 <?php echo $this->runChild('partials.code', ['code' => $source, 'label' => $label ?? 'blade']); ?>
 </div>
</div>