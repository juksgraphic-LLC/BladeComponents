<section id="<?php echo \htmlentities(trim(preg_replace('/[^a-z0-9]+/', '-', strtolower($title ?? '')), '-')??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="scroll-mt-6 rounded-radius border border-outline bg-surface dark:border-outline-dark dark:bg-surface-dark <?php echo \htmlentities($wide ?? false ? 'xl:col-span-2' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="border-b border-outline px-6 py-4 dark:border-outline-dark">
 <h2 class="font-title text-base font-semibold text-on-surface dark:text-on-surface-dark"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>
 <?php if(!empty($description)): ?>
 <p class="mt-0.5 font-paragraph text-sm text-on-surface/60 dark:text-on-surface-dark/60"><?php echo $description; ?></p>
 <?php endif; ?>
 </div>
 <div class="px-6 py-4"><?php echo $slot; ?></div>
</section>