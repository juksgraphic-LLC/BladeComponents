<?php 
/**
 * Alert component — Juksgraphic / Penguin UI
 *
 * Reusable alert built with Tailwind CSS and Alpine.js.
 * Works with Laravel Blade and BladeOne.
 *
 * @param string      $type        Color variant: primary|secondary|success|danger|warning|info|light|dark. Default: 'primary'.
 * @param string      $style       Layout variant: default|borderless|outline|left-border|top-border|solid|label-icon|label-icon-arrow|rounded-label. Default: 'default'.
 * @param bool        $dismissible Show a close button (requires Alpine.js). Default: false.
 * @param bool|string $icon        true = default icon, string starting with "<" = custom SVG. Default: false.
 * @param string|null $title       Alert title (escaped). Default: null.
 * @param string      $message     Alert message (rendered as raw HTML). Default: ''.
 * @param string|null $link        URL of the optional link. Default: null.
 * @param string      $linkText    Text of the optional link. Default: 'Learn more'.
 * @param bool        $live        Hidden alert displayed by the "jkc-alert" window event. Default: false.
 * @param string|null $id          HTML id / Event target identifier. Default: null.
 * @param string      $class       Extra CSS classes. Default: ''.
 * @param string      $attrs       Extra HTML attributes. Default: ''.
 * @param string      $closeLabel  Accessible label of the close button. Default: 'Close'.
 */

/** @var string $type */
$type = (string) ($type ?? 'primary');

/** @var string $style */
$style = (string) ($style ?? 'default');

/** @var bool $dismissible */
$dismissible = (bool) ($dismissible ?? false);

/** @var bool|string $icon */
$icon = $icon ?? false;

/** @var string|null $title */
$title = $title ?? null;

/** @var string $message */
$message = $message ?? '';

/** @var string|null $link */
$link = $link ?? null;

/** @var string $linkText */
$linkText = $linkText ?? 'Learn more';

/** @var bool $live */
$live = (bool) ($live ?? false);

/** @var string|null $id */
$id = $id ?? null;

/** @var string $class */
$class = $class ?? '';

/** @var string $attrs */
$attrs = $attrs ?? '';

/** @var string $closeLabel */
$closeLabel = $closeLabel ?? 'Close';

/** @var array<string, string> $icons */
$icons = [
 'info'    => '<svg class="size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>',
 'success' => '<svg class="size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>',
 'danger'  => '<svg class="size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>',
 'warning' => '<svg class="size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>',
];

/** @var array<string, array<string, string>> $themes */
$themes = [
 'primary' => [
 'softBg'      => 'bg-primary/10 dark:bg-primary-dark/10',
 'softText'    => 'text-primary dark:text-primary-dark',
 'softBorder'  => 'border-primary/20 dark:border-primary-dark/20',
 'solidBg'     => 'bg-primary dark:bg-primary-dark',
 'solidText'   => 'text-on-primary dark:text-on-primary-dark',
 'border'      => 'border-primary dark:border-primary-dark',
 'outlineBg'   => 'bg-surface dark:bg-surface-dark',
 'badgeBg'     => 'bg-primary/15 dark:bg-primary-dark/15',
 'defaultIcon' => 'info',
 ],
 'secondary' => [
 'softBg'      => 'bg-secondary/10 dark:bg-secondary-dark/10',
 'softText'    => 'text-secondary dark:text-secondary-dark',
 'softBorder'  => 'border-secondary/20 dark:border-secondary-dark/20',
 'solidBg'     => 'bg-secondary dark:bg-secondary-dark',
 'solidText'   => 'text-on-secondary dark:text-on-secondary-dark',
 'border'      => 'border-secondary dark:border-secondary-dark',
 'outlineBg'   => 'bg-surface dark:bg-surface-dark',
 'badgeBg'     => 'bg-secondary/15 dark:bg-secondary-dark/15',
 'defaultIcon' => 'info',
 ],
 'success' => [
 'softBg'      => 'bg-success/10',
 'softText'    => 'text-success',
 'softBorder'  => 'border-success/20',
 'solidBg'     => 'bg-success',
 'solidText'   => 'text-on-success',
 'border'      => 'border-success',
 'outlineBg'   => 'bg-surface dark:bg-surface-dark',
 'badgeBg'     => 'bg-success/15',
 'defaultIcon' => 'success',
 ],
 'danger' => [
 'softBg'      => 'bg-danger/10',
 'softText'    => 'text-danger',
 'softBorder'  => 'border-danger/20',
 'solidBg'     => 'bg-danger',
 'solidText'   => 'text-on-danger',
 'border'      => 'border-danger',
 'outlineBg'   => 'bg-surface dark:bg-surface-dark',
 'badgeBg'     => 'bg-danger/15',
 'defaultIcon' => 'danger',
 ],
 'warning' => [
 'softBg'      => 'bg-warning/10',
 'softText'    => 'text-warning',
 'softBorder'  => 'border-warning/20',
 'solidBg'     => 'bg-warning',
 'solidText'   => 'text-on-warning',
 'border'      => 'border-warning',
 'outlineBg'   => 'bg-surface dark:bg-surface-dark',
 'badgeBg'     => 'bg-warning/15',
 'defaultIcon' => 'warning',
 ],
 'info' => [
 'softBg'      => 'bg-info/10',
 'softText'    => 'text-info',
 'softBorder'  => 'border-info/20',
 'solidBg'     => 'bg-info',
 'solidText'   => 'text-on-info',
 'border'      => 'border-info',
 'outlineBg'   => 'bg-surface dark:bg-surface-dark',
 'badgeBg'     => 'bg-info/15',
 'defaultIcon' => 'info',
 ],
 'light' => [
 'softBg'      => 'bg-surface-alt',
 'softText'    => 'text-on-surface-strong',
 'softBorder'  => 'border-outline',
 'solidBg'     => 'bg-surface-alt',
 'solidText'   => 'text-on-surface-strong',
 'border'      => 'border-outline-strong',
 'outlineBg'   => 'bg-surface',
 'badgeBg'     => 'bg-surface',
 'defaultIcon' => 'info',
 ],
 'dark' => [
 'softBg'      => 'bg-surface-dark-alt',
 'softText'    => 'text-on-surface-dark',
 'softBorder'  => 'border-outline-dark',
 'solidBg'     => 'bg-surface-dark',
 'solidText'   => 'text-on-surface-dark',
 'border'      => 'border-outline-dark-strong',
 'outlineBg'   => 'bg-surface-dark',
 'badgeBg'     => 'bg-surface-dark',
 'defaultIcon' => 'info',
 ],
];

/** @var array<string, string> $theme */
$theme = $themes[$type] ?? $themes['primary'];

/** @var string $variantClasses */
$variantClasses = match ($style) {
 'borderless'  => "{$theme['softBg']} {$theme['softText']}",
 'outline'     => "{$theme['outlineBg']} border {$theme['border']} {$theme['softText']}",
 'left-border' => "{$theme['softBg']} border-l-4 {$theme['border']} {$theme['softText']}",
 'top-border'  => "{$theme['softBg']} border-t-4 {$theme['border']} {$theme['softText']}",
 'solid'       => "{$theme['solidBg']} {$theme['solidText']}",
 default       => "{$theme['softBg']} border {$theme['softBorder']} {$theme['softText']}",
};

/** @var string $classes */
$classes = preg_replace('/\s+/', ' ', trim(
 'relative flex w-full items-start rounded-radius p-4 font-paragraph text-sm '
 . $variantClasses
 . ($dismissible ? ' pr-12' : '')
 . ' ' . $class
));

/** @var bool $isLabel */
$isLabel = in_array($style, ['label-icon', 'label-icon-arrow', 'rounded-label'], true);

/** @var bool $hasIcon */
$hasIcon = $isLabel || !empty($icon);

/** @var string $iconHtml */
$iconHtml = (is_string($icon) && str_starts_with(ltrim($icon), '<'))
 ? $icon
 : $icons[$theme['defaultIcon']];

/** @var string|null $safeLink */
$safeLink = null;
if (is_string($link) && trim($link) !== '' && !preg_match('/^\s*(javascript|data|vbscript):/i', $link)) {
 $safeLink = trim($link);
}

/** @var string|null $safeId */
$safeId = $id ? preg_replace('/[^A-Za-z0-9_-]/', '', (string) $id) : null;

/** @var string $role */
$role = in_array($type, ['danger', 'warning'], true) ? 'alert' : 'status';
 ?>

<?php /* ═══════════════════════════ Template ═══════════════════════════ */ ?>
<div 
 <?php if($safeId): ?> id="<?php echo \htmlentities($safeId??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php endif; ?>
 role="<?php echo \htmlentities($role??'', ENT_QUOTES, 'UTF-8', false); ?>"
 <?php if($live || $dismissible): ?>
 x-data="{ 
 show: <?php echo \htmlentities($live ? 'false' : 'true'??'', ENT_QUOTES, 'UTF-8', false); ?>,
 dismiss() {
 this.show = false;
 this.$dispatch('jkc-alert-close', { id: <?php echo \htmlentities($safeId ? "'$safeId'" : 'null'??'', ENT_QUOTES, 'UTF-8', false); ?> });
 }
 }"
 x-show="show"
 x-transition:enter="transition ease-out duration-200"
 x-transition:enter-start="opacity-0 -translate-y-2"
 x-transition:enter-end="opacity-100 translate-y-0"
 x-transition:leave="transition ease-in duration-200"
 x-transition:leave-start="opacity-100 translate-y-0"
 x-transition:leave-end="opacity-0 -translate-y-2"
 <?php endif; ?>
 <?php if($live): ?>
 x-on:jkc-alert.window="if (<?php echo \htmlentities($safeId ? "\$event.detail?.id === '{$safeId}'" : 'true'??'', ENT_QUOTES, 'UTF-8', false); ?>) show = true"
 style="display: none"
 <?php endif; ?>
 class="<?php echo \htmlentities($classes??'', ENT_QUOTES, 'UTF-8', false); ?>"
 <?php echo $attrs; ?>

>
 <?php /* Icon: badge (label-* styles) */ ?>
 <?php if($hasIcon && $isLabel): ?>
 <span class="mr-3 inline-flex size-8 shrink-0 items-center justify-center <?php echo \htmlentities($style === 'rounded-label' ? 'rounded-full' : 'rounded-lg'??'', ENT_QUOTES, 'UTF-8', false); ?> <?php echo \htmlentities($theme['badgeBg']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo $iconHtml; ?>

 </span>
 <?php /* Icon: simple */ ?>
 <?php elseif($hasIcon): ?>
 <span class="mr-3 mt-0.5 shrink-0"><?php echo $iconHtml; ?></span>
 <?php endif; ?>

 <?php /* Content: title, message, link */ ?>
 <div class="min-w-0 flex-1 <?php echo \htmlentities($isLabel ? 'self-center' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if($title): ?>
 <p class="mb-1 font-title text-base font-semibold"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <hr class="mb-2 border-current opacity-20">
 <?php endif; ?>

 <?php echo $message; ?>


 <?php if($safeLink): ?>
 <a href="<?php echo \htmlentities($safeLink??'', ENT_QUOTES, 'UTF-8', false); ?>" class="ml-1 font-medium underline underline-offset-2 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current">
 <?php echo \htmlentities($linkText??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 <?php endif; ?>
 </div>

 <?php /* Arrow (label-icon-arrow style) */ ?>
 <?php if($style === 'label-icon-arrow'): ?>
 <svg class="ml-2 size-4 shrink-0 self-center" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
 </svg>
 <?php endif; ?>

 <?php /* Close button (dismissible) */ ?>
 <?php if($dismissible): ?>
 <button type="button" x-on:click="dismiss()" aria-label="<?php echo \htmlentities(htmlspecialchars($closeLabel, ENT_QUOTES, 'UTF-8')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="absolute right-3 top-3 rounded-lg p-1.5 transition-colors hover:bg-black/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current dark:hover:bg-white/10">
 <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
 </svg>
 </button>
 <?php endif; ?>
</div>