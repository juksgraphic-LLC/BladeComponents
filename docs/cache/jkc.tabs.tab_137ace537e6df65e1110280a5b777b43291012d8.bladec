<?php 
 /**
 * Tabs component — Juksgraphic / Penguin UI
 *
 * Reusable tabs built with Tailwind CSS and Alpine.js.
 * Works with Laravel Blade and BladeOne.
 *
 * @param string      $variant      Layout variant: default|pills|pills-justified|justified|vertical|card-header|card-footer|arrow|custom-tabs|custom-hover|custom-vertical|animation|border-top|border-top-justified|outline|custom|colored|light. Default: 'default'.
 * @param string      $color        Color variant: primary|secondary|success|danger|warning|info. Default: 'primary'.
 * @param array       $tabs         Array of tabs [ ['label'=>'', 'icon'=>'', 'badge'=>'', 'active'=>bool, 'disabled'=>bool, 'content'=>''], ... ]. Default: [].
 * @param string|null $id           Base ID for the group. Default: auto-generated.
 * @param string      $tabClass     Extra CSS classes on the root wrapper. Default: ''.
 * @param string      $contentClass Extra CSS classes on the content panels. Default: ''.
 */

 /** @var string $variant */
 $variant = (string) ($variant ?? 'default');

 /** @var string $color */
 $color = (string) ($color ?? 'primary');

 /** @var array<int, array{label?: string, icon?: string, badge?: string, active?: bool, disabled?: bool, content?: string}> $tabs */
 $tabs = $tabs ?? [];

 /** @var string $tabClass */
 $tabClass = (string) ($tabClass ?? '');

 /** @var string $contentClass */
 $contentClass = (string) ($contentClass ?? '');

 /** @var string $groupId */
 $groupId = isset($id) ? preg_replace('/[^A-Za-z0-9_-]/', '', (string) $id) : 'jkc-tabs-' . bin2hex(random_bytes(4));

 $colorMap = [
 'primary' => 'primary',
 'secondary' => 'secondary',
 'success' => 'success',
 'danger' => 'danger',
 'warning' => 'warning',
 'info' => 'info',
 ];
 $c = $colorMap[$color] ?? 'primary';

 $activeIndex = 0;
 foreach ($tabs as $_i => $_tab) {
 if (!empty($_tab['active']) && empty($_tab['disabled'])) {
 $activeIndex = $_i;
 break;
 }
 }

 $_baseBtn =
 'inline-flex items-center gap-1.5 text-sm font-medium font-paragraph transition-all duration-200 focus:outline-none ';
 $_disabledMod = 'opacity-40 pointer-events-none cursor-not-allowed ';

 $_active = [
 'default' => "border-{$c} text-{$c}",
 'justified' => "border-{$c} text-{$c}",
 'pills' => "bg-{$c} text-on-{$c}",
 'pills-justified' => "bg-{$c} text-on-{$c}",
 'vertical' => "bg-{$c} text-on-{$c}",
 'card-header' => "border-{$c} text-{$c} bg-surface dark:bg-surface-dark -mb-px",
 'card-footer' => "border-{$c} text-{$c}",
 'arrow' => "bg-{$c} text-on-{$c}",
 'custom-tabs' => "border-{$c} border-b-surface dark:border-b-surface-dark text-{$c} bg-surface dark:bg-surface-dark",
 'custom-hover' => "border-{$c} text-{$c} bg-{$c}/5",
 'custom-vertical' => "border-{$c} text-{$c} bg-{$c}/5",
 'animation' => "text-{$c}",
 'border-top' => "border-{$c} text-{$c}",
 'border-top-justified' => "border-{$c} text-{$c}",
 'outline' => "border-{$c} text-{$c} bg-{$c}/5",
 'custom' => "bg-{$c} text-on-{$c} shadow-md shadow-{$c}/30",
 'colored' => "bg-{$c} text-on-{$c}",
 'light' => "border-{$c}/40 text-{$c}/80",
 ];

 $_inactive = [
 'default' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:border-outline dark:hover:border-outline-dark hover:text-on-surface dark:hover:text-on-surface-dark',
 'justified' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:border-outline hover:text-on-surface dark:hover:text-on-surface-dark',
 'pills' =>
 'text-on-surface/60 dark:text-on-surface-dark/60 hover:bg-surface-alt dark:hover:bg-white/10 hover:text-on-surface dark:hover:text-on-surface-dark',
 'pills-justified' =>
 'text-on-surface/60 dark:text-on-surface-dark/60 hover:bg-surface-alt dark:hover:bg-white/10 hover:text-on-surface dark:hover:text-on-surface-dark',
 'vertical' =>
 'text-on-surface/60 dark:text-on-surface-dark/60 hover:bg-surface-alt dark:hover:bg-white/10 hover:text-on-surface dark:hover:text-on-surface-dark',
 'card-header' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:text-on-surface dark:hover:text-on-surface-dark',
 'card-footer' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:text-on-surface dark:hover:text-on-surface-dark',
 'arrow' =>
 'text-on-surface/60 dark:text-on-surface-dark/60 hover:bg-surface-alt dark:hover:bg-white/10 hover:text-on-surface dark:hover:text-on-surface-dark',
 'custom-tabs' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:text-on-surface dark:hover:text-on-surface-dark',
 'custom-hover' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:bg-surface-alt dark:hover:bg-white/5 hover:text-on-surface dark:hover:text-on-surface-dark',
 'custom-vertical' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:bg-surface-alt dark:hover:bg-white/5 hover:text-on-surface dark:hover:text-on-surface-dark',
 'animation' =>
 'text-on-surface/60 dark:text-on-surface-dark/60 hover:text-on-surface dark:hover:text-on-surface-dark',
 'border-top' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:text-on-surface dark:hover:text-on-surface-dark',
 'border-top-justified' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:text-on-surface dark:hover:text-on-surface-dark',
 'outline' =>
 'border-transparent text-on-surface/60 dark:text-on-surface-dark/60 hover:border-outline dark:hover:border-outline-dark hover:text-on-surface dark:hover:text-on-surface-dark',
 'custom' =>
 'text-on-surface/60 dark:text-on-surface-dark/60 hover:bg-surface-alt dark:hover:bg-white/10 hover:text-on-surface dark:hover:text-on-surface-dark',
 'colored' =>
 'bg-surface-alt dark:bg-white/5 text-on-surface dark:text-on-surface-dark hover:bg-surface-alt/80 dark:hover:bg-white/10',
 'light' =>
 'border-transparent text-on-surface/40 dark:text-on-surface-dark/40 hover:border-outline/50 hover:text-on-surface/70 dark:hover:text-on-surface-dark/70',
 ];

 $_shape = [
 'default' => 'px-4 py-2.5 border-b-2 ',
 'justified' => 'px-4 py-2.5 border-b-2 flex-1 justify-center ',
 'pills' => 'px-4 py-1.5 rounded-full ',
 'pills-justified' => 'px-4 py-1.5 rounded-full flex-1 justify-center ',
 'vertical' => 'px-4 py-2.5 rounded-radius w-full justify-start ',
 'card-header' => 'px-4 py-2.5 border-b-2 ',
 'card-footer' => 'px-4 py-2.5 border-t-2 ',
 'arrow' => 'px-4 py-2.5 rounded-radius ',
 'custom-tabs' => 'px-4 py-2.5 border-2 rounded-t-radius ',
 'custom-hover' => 'px-5 py-3 border-b-2 ',
 'custom-vertical' => 'px-4 py-3 border-l-4 w-full justify-start ',
 'animation' => 'px-4 py-2.5 relative ',
 'border-top' => 'px-4 py-2.5 border-t-2 ',
 'border-top-justified' => 'px-4 py-2.5 border-t-2 flex-1 justify-center ',
 'outline' => 'px-4 py-1.5 rounded-full border ',
 'custom' => 'px-4 py-1.5 rounded-full ',
 'colored' => 'px-4 py-1.5 rounded-full ',
 'light' => 'px-4 py-2.5 border-b-2 ',
 ];

 $_shape_v = $_shape[$variant] ?? $_shape['default'];
 $_active_v = $_active[$variant] ?? '';
 $_inactive_v = $_inactive[$variant] ?? '';

 $_getClasses = static function (bool $isActive, bool $isDisabled) use (
 $_baseBtn,
 $_shape_v,
 $_active_v,
 $_inactive_v,
 $_disabledMod,
 ): string {
 $disabled = $isDisabled ? $_disabledMod : '';
 $state = $isActive ? $_active_v : $_inactive_v;
 return trim($_baseBtn . $_shape_v . $disabled . $state);
 };

 $_isVertical = in_array($variant, ['vertical', 'custom-vertical'], true);

 if (!$_isVertical) {
 $_wrapClass = match ($variant) {
 'pills', 'custom', 'colored', 'outline' => 'flex flex-wrap gap-1',
 'pills-justified' => 'flex w-full gap-1',
 'card-header' => 'flex flex-wrap border-b border-outline dark:border-outline-dark',
 'card-footer' => 'flex flex-wrap border-t border-outline dark:border-outline-dark',
 'custom-tabs' => "flex flex-wrap gap-x-1 border-b border-{$c}",
 'animation' => 'flex flex-wrap border-b border-outline dark:border-outline-dark gap-x-2',
 'border-top', 'border-top-justified' => 'flex flex-wrap',
 'custom-hover' => 'flex flex-wrap border-b border-outline dark:border-outline-dark',
 default => 'flex flex-wrap border-b border-outline dark:border-outline-dark',
 };
 } else {
 $_wrapClass = 'flex flex-col gap-y-0.5 min-w-[160px]';
 }
 ?>

<div id="<?php echo \htmlentities($groupId??'', ENT_QUOTES, 'UTF-8', false); ?>" x-data="{
 activeTab: <?php echo \htmlentities($activeIndex??'', ENT_QUOTES, 'UTF-8', false); ?>,
 changeTab(index) {
 this.activeTab = index;
 this.$dispatch('jkc-tabs-change', { id: '<?php echo \htmlentities($groupId??'', ENT_QUOTES, 'UTF-8', false); ?>', index: index });
 }
}"
 class="<?php echo \htmlentities($_isVertical ? 'flex gap-4' : 'flex flex-col'??'', ENT_QUOTES, 'UTF-8', false); ?> <?php echo \htmlentities($tabClass??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php /* Tabs Navigation */ ?>
 <div class="<?php echo \htmlentities($_wrapClass??'', ENT_QUOTES, 'UTF-8', false); ?>" role="tablist">
 <?php $__currentLoopData = $tabs; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $_idx => $_tab): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $_isActive = $_idx === $activeIndex;
 $_isDisabled = !empty($_tab['disabled']);
 $_activeClsStr = $_getClasses(true, $_isDisabled);
 $_inactiveClsStr = $_getClasses(false, $_isDisabled);
 ?>

 <button type="button" id="<?php echo \htmlentities($groupId??'', ENT_QUOTES, 'UTF-8', false); ?>-tab-<?php echo \htmlentities($_idx??'', ENT_QUOTES, 'UTF-8', false); ?>" role="tab"
 :aria-selected="activeTab === <?php echo \htmlentities($_idx??'', ENT_QUOTES, 'UTF-8', false); ?> ? 'true' : 'false'"
 <?php if($_isDisabled): ?> disabled tabindex="-1"
 <?php else: ?>@click="changeTab(<?php echo \htmlentities($_idx??'', ENT_QUOTES, 'UTF-8', false); ?>)" <?php endif; ?>
 :class="activeTab === <?php echo \htmlentities($_idx??'', ENT_QUOTES, 'UTF-8', false); ?> ? '<?php echo \htmlentities($_activeClsStr??'', ENT_QUOTES, 'UTF-8', false); ?>' : '<?php echo \htmlentities($_inactiveClsStr??'', ENT_QUOTES, 'UTF-8', false); ?>'"
 class="<?php echo \htmlentities($_getClasses($_isActive, $_isDisabled)??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if(!empty($_tab['icon'])): ?>
 <span class="shrink-0 w-4 h-4"><?php echo $_tab['icon']; ?></span>
 <?php endif; ?>

 <?php echo \htmlentities($_tab['label'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?>


 <?php if(!empty($_tab['badge'])): ?>
 <span
 class="ml-1 inline-flex items-center justify-center px-1.5 py-0.5 rounded-full text-[10px] font-semibold leading-none bg-<?php echo \htmlentities($c??'', ENT_QUOTES, 'UTF-8', false); ?> text-on-<?php echo \htmlentities($c??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($_tab['badge']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 <?php endif; ?>

 <?php if($variant === 'animation'): ?>
 <span x-show="activeTab === <?php echo \htmlentities($_idx??'', ENT_QUOTES, 'UTF-8', false); ?>"
 x-transition:enter="transition ease-out duration-300"
 x-transition:enter-start="scale-x-0 opacity-0" x-transition:enter-end="scale-x-100 opacity-100"
 class="absolute bottom-0 left-0 right-0 h-0.5 bg-<?php echo \htmlentities($c??'', ENT_QUOTES, 'UTF-8', false); ?> rounded-full origin-left"
 style="display:none">
 </span>
 <?php endif; ?>

 <?php if($variant === 'arrow'): ?>
 <span x-show="activeTab === <?php echo \htmlentities($_idx??'', ENT_QUOTES, 'UTF-8', false); ?>" class="ml-auto" style="display:none">
 <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
 <path fill-rule="evenodd"
 d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
 clip-rule="evenodd" />
 </svg>
 </span>
 <?php endif; ?>
 </button>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>

 <?php /* Content Panels */ ?>
 <div class="flex-1 <?php echo \htmlentities($contentClass??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php $__currentLoopData = $tabs; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $_idx => $_tab): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $_slotVar = 'slot_' . $_idx;
 $_panelContent = isset($$_slotVar) ? $$_slotVar : $_tab['content'] ?? '';
 ?>

 <div id="<?php echo \htmlentities($groupId??'', ENT_QUOTES, 'UTF-8', false); ?>-panel-<?php echo \htmlentities($_idx??'', ENT_QUOTES, 'UTF-8', false); ?>" x-show="activeTab === <?php echo \htmlentities($_idx??'', ENT_QUOTES, 'UTF-8', false); ?>"
 x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-1"
 x-transition:enter-end="opacity-100 translate-y-0" role="tabpanel"
 :aria-labelledby="'<?php echo \htmlentities($groupId??'', ENT_QUOTES, 'UTF-8', false); ?>-tab-<?php echo \htmlentities($_idx??'', ENT_QUOTES, 'UTF-8', false); ?>'"
 style="<?php echo \htmlentities($_idx !== $activeIndex ? 'display:none' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" class="py-3">
 <?php echo $_panelContent; ?>

 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
</div>
